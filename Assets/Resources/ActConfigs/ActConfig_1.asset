  m_Script: {fileID: 11500000, guid: 5a826555e5b3ef94db78721ec92896a2, type: 3}
  m_Name: ActConfig_1
  m_EditorClassIdentifier: 
  actId: 1
  actName: "\u9B54\u738B\u7684\u8BD5\u70BC"
  description: "\u7A7A\u4E4B\u9B54\u738B\u521D\u6B21\u964D\u4E34\uFF0C\u52C7\u8005\u8E0F\u4E0A\u5F81\u9014\u7684\u7B2C\u4E00\u6BB5\u65C5\u7A0B\u3002"
  mainScriptName: plot1
  introLabel: Intro
  outroLabel: Outro
  preBattleDialogues:
  - stageNumber: 1
    useNaninovel: 0
    labelName: 
    inSceneLines:
    - "\u53D8\u5F3A\u7684\u8DEF\u4E0A\u603B\u8981\u5931\u53BB\u4E9B\u4EC0\u4E48\uFF0C\u4E0D\u662F\u5417\uFF1F"
    - "\u6211\u627E\u6076\u4E4B\u9B54\u738B\u5E2E\u6211\u89E3\u51B3\u4E00\u4E9B\u9EBB\u70E6\uFF0C\u7ED3\u679C\u6070\u597D\u9047\u4E0A\u4E86\u4EBA\u7C7B\u52C7\u8005\u7684\u8BA8\u4F10"
    - "\u6211\u4EEC\u5F97\u53BB\u5E2E\u5E2E\u6076\u4E4B\u9B54\u738B\uFF0C\u62D6\u62FD\u53F3\u8FB9\u7684\u53EF\u8D2D\u4E70\u89D2\u8272\uFF0C\u51FB\u9000\u654C\u4EBA\u5427"
  - stageNumber: 5
    useNaninovel: 0
    labelName: 
    inSceneLines:
    - "\uFF08\u5360\u4F4D\uFF09\u4E0D\u5BF9\u52B2\u3002\u8FD9\u9644\u8FD1\u7684\u9B54\u529B\u6D41\u52A8\u6BD4\u4E4B\u524D\u5F3A\u4E86\u5F88\u591A\u3002"
    - "\uFF08\u5360\u4F4D\uFF09\u6709\u4EBA\u5728\u6545\u610F\u5F15\u5BFC\u6211\u4EEC\u671D\u67D0\u4E2A\u65B9\u5411\u8D70\u3002\u5C0F\u5FC3\u70B9\u3002"
  - stageNumber: 10
    useNaninovel: 0
    labelName: 
    inSceneLines:
    - "\uFF08\u5360\u4F4D\uFF09\u6211\u770B\u5230\u4E86\u3002\u524D\u9762\u90A3\u4E2A\u8EAB\u5F71\u2026\u2026\u662F\u4ED6\u3002"
    - "\uFF08\u5360\u4F4D\uFF09\u6D6E\u6728\u7684\u6B8B\u5F71\u8FD8\u5728\u8FD9\u7247\u68EE\u6797\u91CC\u6E38\u8361\u3002\u51A0\u5195\u5728\u5171\u9E23\u3002"
  - stageNumber: 15
    useNaninovel: 0
    labelName: 
    inSceneLines:
    - "\uFF08\u5360\u4F4D\uFF09\u51A0\u5195\u5728\u53D1\u70EB\u3002\u4ECE\u6765\u6CA1\u6709\u8FD9\u6837\u8FC7\u3002"
    - "\uFF08\u5360\u4F4D\uFF09\u8FD9\u7247\u571F\u5730\u4E0B\u9762\u6709\u4E1C\u897F\u5728\u56DE\u5E94\u51A0\u5195\u3002\u4F60\u611F\u89C9\u5230\u4E86\u5417\uFF1F"
  - stageNumber: 20
    useNaninovel: 0
    labelName: 
    inSceneLines:
    - "\uFF08\u5360\u4F4D\uFF09\u5DF2\u7ECF\u5230\u8FD9\u4E00\u6B65\u4E86\u3002\u518D\u5F80\u524D\uFF0C\u5C31\u662F\u8FD9\u8F6E\u8F6E\u56DE\u7684\u7EC8\u70B9\u3002"
    - "\uFF08\u5360\u4F4D\uFF09\u6211\u4E0D\u77E5\u9053\u8FD9\u4E00\u6B21\u7ED3\u5C40\u4F1A\u600E\u6837\u3002\u4F46\u8FD9\u4E00\u6B21\u2026\u2026\u81F3\u5C11\u6211\u4E0D\u662F\u4E00\u4E2A\u4EBA\u3002"
  - stageNumber: 21
    useNaninovel: 0
    labelName: 
    inSceneLines:
    - "\uFF08\u5360\u4F4D\uFF09\u6765\u4E86\u3002\u8FD9\u4E2A\u5927\u5C40\u7684\u652F\u914D\u8005\u5C31\u5728\u524D\u9762\u3002"
    - "\uFF08\u5360\u4F4D\uFF09\u6253\u5B8C\u8FD9\u4E00\u573A\uFF0C\u5982\u679C\u51A0\u5195\u8FD8\u4E0D\u91CD\u7F6E\u2026\u2026\u6211\u4EEC\u5C31\u80FD\u7EE7\u7EED\u5F80\u524D\u8D70\u3002\u51C6\u5907\u597D\u4E86\u5417\uFF1F"
