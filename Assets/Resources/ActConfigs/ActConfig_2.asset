  m_Name: ActConfig_2
  m_EditorClassIdentifier: 
  actId: 2
  actName: "\u706B\u4E4B\u9B54\u738B"
  description: "\u6676\u4E4B\u52C7\u8005\u5C0F\u961F\u6DF1\u5165\u9669\u5883\uFF0C\u5BFB\u627E\u9B54\u6CD5\u5E08\u5343\u5854\uFF0C\u4E0E\u706B\u4E4B\u9B54\u738B\u5C55\u5F00\u751F\u6B7B\u4E4B\u6218\u3002"
  mainScriptName: plot2
  introLabel: Intro
  outroLabel: Outro
  preBattleDialogues:
  - stageNumber: 1
    useNaninovel: 0
    labelName: 
    inSceneLines:
    - "\u7A7A\u4E4B\u9B54\u738B\u4E0E\u5B54\u96F7\u6F5C\u5165\u4E86\u9010\u6D6A\u56FD\u7687\u57CE\u3002"
    - "\u738B\u5BA4\u5BC6\u6587\u5E93\u4E2D\uFF0C\u6216\u8BB8\u85CF\u7740\u6B7B\u4E4B\u9B54\u738B\u5931\u8E2A\u7684\u7EBF\u7D22\u3002"
    - "\u4F46\u5B88\u536B\u68EE\u4E25\uFF0C\u60F3\u8FDB\u53BB\u5F97\u5148\u8FC7\u4E86\u8FD9\u5173\u3002"
  - stageNumber: 5
    useNaninovel: 0
    labelName: 
    inSceneLines:
    - "\u5BC6\u6587\u4E2D\u63D0\u5230\u4E86\u4E00\u4E2A\u4F1A\u5206\u8EAB\u672F\u7684\u6CD5\u5E08\u2014\u2014\u9B54\u65CF\u4EBA\u5F62\u6001\u7684\u6CD5\u5E08\u4E0D\u591A\u3002"
    - "\u4F1A\u5206\u8EAB\u672F\u7684\u53EA\u6709\u6B7B\u4E4B\u9B54\u738B\u548C\u4ED6\u7684\u4E00\u4E2A\u4E0B\u5C5E\u3002"
    - "\u770B\u6765\u6B7B\u4E4B\u9B54\u738B\u7684\u6545\u4E8B\u8FDC\u6BD4\u60F3\u8C61\u4E2D\u590D\u6742\u3002"
  - stageNumber: 10
    useNaninovel: 0
    labelName: 
    inSceneLines:
    - "\u65E5\u8BB0\u7684\u6B8B\u9875\u63ED\u793A\u4E86\u4E00\u6BB5\u60CA\u4EBA\u7684\u5F80\u4E8B\u2014\u2014"
    - "\u6B7B\u4E4B\u9B54\u738B\u66FE\u4F2A\u88C5\u6210\u6CD5\u5E08\u6F5C\u4F0F\u5728\u54C0\u4E4B\u52C7\u8005\u7684\u961F\u4F0D\u4E2D\u3002"
    - "\u4ED6\u8BF4\u662F\u4E3A\u4E86\u63A2\u67E5\u795E\u660E\u795D\u798F\u7684\u80FD\u529B\uFF0C\u4F46\u4E8B\u60C5\u771F\u7684\u8FD9\u4E48\u7B80\u5355\u5417\uFF1F"
  - stageNumber: 15
    useNaninovel: 0
    labelName: 
    inSceneLines:
    - "\u5728\u90A3\u573A\u8BA8\u4F10\u7A7A\u4E4B\u9B54\u738B\u7684\u6218\u6597\u4E2D\uFF0C\u6B7B\u4E4B\u9B54\u738B\u9009\u62E9\u4E86\u80CC\u53DB\u9B54\u65CF\u3002"
    - "\u4ED6\u66FF\u54C0\u4E4B\u52C7\u8005\u6321\u4E0B\u4E86\u81F4\u547D\u7684\u4E00\u51FB\u3002"
    - "\u516D\u5341\u4E8C\u5E74\u7684\u966A\u4F34\uFF0C\u4ECE\u6F5C\u4F0F\u5F00\u59CB\uFF0C\u4EE5\u771F\u60C5\u7ED3\u675F\u3002"
  - stageNumber: 21
    useNaninovel: 0
    labelName: 
    inSceneLines:
    - "\u8FD9\u5C31\u662F\u6211\u4EEC\u8FFD\u5BFB\u7684\u7EC8\u70B9\u4E86\u3002"
    - "\u6B7B\u4E4B\u9B54\u738B\u7684\u6545\u4E8B\uFF0C\u7A7A\u4E4B\u9B54\u738B\u7684\u6545\u4E8B\u2014\u2014\u90FD\u4EA4\u7EC7\u5728\u8FD9\u91CC\u3002"
    - "\u51C6\u5907\u597D\u4E86\u5417\uFF1F"
